{
  "name": "aria-live-capture",
  "version": "2.0.0",
  "description": "Capture announcements of ARIA-live regions",
  "keywords": [
    "a11y",
    "accessibility",
    "aria",
    "aria-live"
  ],
  "homepage": "https://github.com/AriPerkkio/aria-live-capture",
  "bugs": "https://github.com/AriPerkkio/aria-live-capture",
  "license": "MIT",
  "author": "Ari Perkkio <ari.perkkio@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/AriPerkkio/aria-live-capture"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "changelog": "npx conventional-changelog-cli -i CHANGELOG.md -p angular -s -r 0",
    "prebuild": "rm -rf ./dist",
    "build": "tsc --project tsconfig.prod.json",
    "fmt": "oxfmt",
    "lint": "publint && oxlint",
    "test": "vitest run",
    "test:docs": "start-server-and-test docs:run 8080 docs:test",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm build && pnpm docs:build && pnpm lint && pnpm typecheck && pnpm test && pnpm test:docs",
    "docs": "storybook dev -p 6006",
    "docs:build": "storybook build --output-dir docs",
    "docs:deploy": "touch docs/.nojekyll && gh-pages --dist docs --dotfiles",
    "docs:run": "live-server docs --mount=/aria-live-capture:docs",
    "docs:test": "vitest run --config ./vitest.config.docs.ts"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/html": "10.6.1",
    "@storybook/html-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.1",
    "live-server": "1.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "1.63.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "start-server-and-test": "^3.0.12",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "virtual-dom-nodes": "^0.2.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.28.4"
}
